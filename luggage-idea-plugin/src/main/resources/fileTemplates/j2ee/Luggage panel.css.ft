.${PLUGIN_ID}-panel {
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: inherit;
}

.${PLUGIN_ID}-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.${PLUGIN_ID}-label {
    font-size: 12px;
    opacity: 0.8;
}

.${PLUGIN_ID}-input {
    padding: 4px 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: inherit;
    border-radius: 3px;
}

.${PLUGIN_ID}-go {
    padding: 6px 10px;
    background: #2d7;
    color: #111;
    border: 0;
    border-radius: 3px;
    cursor: pointer;
    font-weight: 600;
}

.${PLUGIN_ID}-go:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.${PLUGIN_ID}-status {
    font-size: 12px;
    min-height: 1em;
}

.${PLUGIN_ID}-error { color: #f55; }
.${PLUGIN_ID}-ok    { color: #5d7; }
